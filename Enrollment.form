
<!DOCTYPE html>
<html>
<head>
<title>Enrollment Form</title>
</head>
<body>

<h1>Student Enrollment Form</h1>

<form>
    <input type="text" placeholder="Student Name" required><br><br>

    <input type="email" placeholder="Email Address" required><br><br>

    <input type="number" placeholder="Phone Number" required><br><br>

    <input type="text" placeholder="Course Name" required><br><br>

    <input type="text" placeholder="Address" required><br><br>

    <button type="submit">Submit Form</button>
</form>

</body>
</html>
